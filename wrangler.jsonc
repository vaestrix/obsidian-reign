{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "obsidian-reign",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-28",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      { "name": "COMMAND_STORE", "class_name": "CommandStore" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["CommandStore"] }
  ]
}
