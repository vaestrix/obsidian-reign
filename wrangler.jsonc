{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "obsidian-reign",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-08",
  "durable_objects": {
    "bindings": [
      {
        "name": "COMMAND_STORE",
        "class_name": "CommandStore"
      },
      {
        "name": "SAVANNAH_INBOX",
        "class_name": "SavannahInbox"
      },
      {
        "name": "PROJECT_HUB",
        "class_name": "ProjectHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "CommandStore"
      ]
    },
    {
      "tag": "savannah-v1",
      "new_sqlite_classes": [
        "SavannahInbox"
      ]
    },
    {
      "tag": "projects-v1",
      "new_sqlite_classes": [
        "ProjectHub"
      ]
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "PUBLIC_ORIGIN": "https://obsidianreign.gg",
    "SAVANNAH_AUTO_SEND": "false",
    "ANNA_MAILBOX_ID": "AC087f44100a23d1b44998ca5baa35",
    "ANNA_AUTO_SEND": "false",
    "AGENTS_START_AT": "2026-10-24T05:00:00Z",
    "ANNA_POSTAL_ADDRESS_CONFIRMED": "false",
    "ANNA_OUTREACH_VERIFIED": "false"
  },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "build": {
    "command": "node --test test/*.test.js && node scripts/check-agent-deployment.mjs && node scripts/build-assets.js"
  },
  "previews": {
    "vars": {
      "STAGING": "true",
      "SAVANNAH_AUTO_SEND": "false",
      "HOSTINGER_MAILBOX_ID": "",
      "PUBLIC_ORIGIN": "",
      "ANNA_AUTO_SEND": "false",
      "ANNA_POSTAL_ADDRESS_CONFIRMED": "false",
      "ANNA_OUTREACH_VERIFIED": "false"
    },
    "durable_objects": {
      "bindings": [
        {
          "name": "COMMAND_STORE",
          "class_name": "CommandStore"
        },
        {
          "name": "SAVANNAH_INBOX",
          "class_name": "SavannahInbox"
        },
        {
          "name": "PROJECT_HUB",
          "class_name": "ProjectHub"
        }
      ]
    }
  },
  "keep_vars": true
}
